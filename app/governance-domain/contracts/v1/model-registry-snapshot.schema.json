{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-governance/contracts/v1/model-registry-snapshot.schema.json",
  "title": "Model Registry Snapshot V1",
  "description": "Server-owned model and calling-application catalogue. Provider identity and application-attribution quality are declared here rather than inferred later, because both are equality classes: an inferred value that is wrong is a silent protocol or attribution change instead of a visible error.",
  "x-contract-direction": "server-input-only",
  "x-semantic-validation-required": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "snapshotId",
    "tenantId",
    "version",
    "status",
    "capturedAt",
    "expiresAt",
    "sourceRevision",
    "models",
    "applications"
  ],
  "properties": {
    "contractVersion": { "const": "v1" },
    "snapshotId": { "$ref": "#/$defs/safeId" },
    "tenantId": { "$ref": "#/$defs/safeId" },
    "version": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["complete", "incomplete", "stale", "ambiguous", "source-unavailable"]
    },
    "capturedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "sourceRevision": { "$ref": "#/$defs/safeId" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 256 },
    "models": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/modelDescriptor" }
    },
    "applications": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/applicationDescriptor" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["incomplete", "stale", "ambiguous", "source-unavailable"] }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["reason"],
        "properties": {
          "models": { "maxItems": 0 },
          "applications": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "modelAlias": {
      "description": "Deliberately narrower than a safe identifier. The effective policy document rejects the colon, so a composite provider-qualified key would validate here and then fail at composition.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "regionKey": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "providerKey": {
      "description": "Closed on purpose. An open string would let two spellings of one provider pass the equality comparison that stops a downgrade from changing wire protocol.",
      "enum": ["azure-openai", "anthropic", "meta", "mistral", "cohere", "other"]
    },
    "apiFamily": {
      "enum": ["anthropic-messages", "openai-chat-completions", "openai-responses"]
    },
    "modelDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelKey",
        "providerKey",
        "apiFamilies",
        "lifecycle",
        "safetyPolicy"
      ],
      "properties": {
        "modelKey": { "$ref": "#/$defs/modelAlias" },
        "providerKey": { "$ref": "#/$defs/providerKey" },
        "apiFamilies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/apiFamily" }
        },
        "lifecycle": {
          "enum": ["preview", "generally-available", "deprecated", "retired"]
        },
        "safetyPolicy": {
          "description": "The content-safety policy the provider attached to the deployment. Shown rather than enforced: the operator chose it when deploying the model.",
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        }
      }
    },
    "applicationDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationId", "attributionQuality", "displayCode"],
      "properties": {
        "applicationId": { "$ref": "#/$defs/safeId" },
        "attributionQuality": {
          "description": "'strong' is a reviewed client-specific registration or application role. 'generic' is a shared developer tool whose token identifies the user authoritatively but the application only as that tool. An application absent from this catalogue is unavailable, never defaulted to generic.",
          "enum": ["strong", "generic"]
        },
        "displayCode": {
          "description": "An internationalisation key, not a display name, so no vendor string reaches the UI or an export.",
          "$ref": "#/$defs/safeId"
        }
      }
    }
  }
}
